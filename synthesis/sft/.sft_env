export SFT_OPENAI_MODEL="gemini-3-pro-preview-new"
export OPENAI_API_KEY="C3o2Gg54H1dClT7p4cwoVrGnCpF60Wfy_GPT_AK"

# Default network endpoint.
export SFT_OPENAI_AZURE_ENDPOINT="https://aidp-i18ntt-sg.byteintl.net/api/modelhub/online/v2/crawl"

# Office network: switch to the following domain instead.
# export SFT_OPENAI_AZURE_ENDPOINT="https://aidp-i18ntt-sg.tiktok-row.net/api/modelhub/online/v2/crawl"

# Backward-compatible alias.
