# Feishu developer console -> App ID / App Secret
# Fill real values only in the ignored .lark_env file.
LARK_APP_ID=
LARK_APP_SECRET=

# Required allowlist. Get the open_id from the rejection log after sending
# a message once. Keep this restricted to your own Feishu account.
LARK_ALLOWED_OPEN_IDS=

# Optional but recommended when the bot is used in one tenant only.
LARK_ALLOWED_TENANT_KEYS=

# Commands run on this Linux host in this directory.
# Set this to the cluster project or login-node working directory.
LARK_COMMAND_CWD=/path/to/cluster/workdir

# A command that exceeds this duration is terminated and reported as an error.
LARK_COMMAND_TIMEOUT_SECONDS=300

# Only the tail of stderr/stdout is sent back for failures.
LARK_MAX_OUTPUT_CHARS=12000

# SQLite message-id deduplication state.
LARK_STATE_DB=/path/to/lark_state.sqlite3

# Keep this at 1 for the first version so commands run serially.
LARK_MAX_WORKERS=1
LARK_LOG_LEVEL=INFO

# Usually leave this unchanged. It is configurable for a Feishu-compatible endpoint.
LARK_API_BASE_URL=https://open.feishu.cn/open-apis
